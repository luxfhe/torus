#include "boost/outcome.h"
#include "toruslang/ClientLib/ClientLambda.h"
#include "toruslang/ClientLib/KeySetCache.h"
#include "toruslang/ClientLib/Types.h"
#include "toruslang/Common/Error.h"

namespace fhecircuit {
namespace client {

namespace extract {
  using namespace toruslang::clientlib;
  using toruslang::error::StringError;
  using extract_t = TypedClientLambda<scalar_out, tensor1_in, tensor1_in>;
  static const std::string name = "extract";

  static outcome::checked<extract_t, StringError>
  load(std::string outputLib)
  { return extract_t::load(name, outputLib); }
} // namespace extract

} // namespace client
} // namespace fhecircuit
